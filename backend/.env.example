ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/picagent
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=picagent-suite-workbench
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 仅用于迁移升级/回滚验收，数据库名必须包含 test。
PICAGENT_MIGRATION_TEST_DATABASE_URL=

# Image provider request deadline in milliseconds. Keep this aligned with the
# gateway's asynchronous image-task timeout.
IMAGE_GENERATION_TIMEOUT_MS=1800000
